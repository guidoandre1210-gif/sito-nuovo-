# Copia in .env.local e compila. Non committare mai i valori reali.

# URL che riceve le richieste del modulo contatti (JSON: name, email, projectType, message, source).
# Esempi: endpoint Formspree/Getform, webhook Make/Zapier, funzione serverless propria.
CONTACT_WEBHOOK_URL=

# Facoltativo: token inviato come "Authorization: Bearer <token>".
CONTACT_WEBHOOK_TOKEN=
